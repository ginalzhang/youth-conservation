---
import { siteSettings } from "../lib/content";

const {
  title = siteSettings.siteName,
  description = siteSettings.defaultDescription,
  currentPath = "/"
} = Astro.props;

const siteName = siteSettings.siteName;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const navItems = siteSettings.navItems;
const footerLinks = navItems;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="stylesheet" href="/mobile-nav.css" />
  </head>
  <body data-contact-email={siteSettings.contactEmail}>
    <header class="site-header">
      <div class="wrap-nav">
        <a class="brand" href="/" aria-label="Bay Area Youth Conservation home">
          <img src="/assets/bayc-logo.png" alt="" width="34" height="34" />
          <span>Bay Area Youth Conservation</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {
            navItems.map((item) => (
              <a
                class={item.cta ? "btn-nav" : "navlink"}
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <div class="footer-brand">
            <img src="/assets/bayc-logo.png" alt="" width="44" height="44" />
            <h2>Bay Area Youth Conservation</h2>
          </div>
          <p>{siteSettings.footer.body}</p>
        </div>
        <div>
          <div class="kicker">{siteSettings.footer.pagesHeading}</div>
          <div class="footer-links">
            {footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </div>
        <div>
          <div class="kicker">{siteSettings.footer.contactHeading}</div>
          <div class="footer-links">
            <a href={siteSettings.instagramUrl}>{siteSettings.instagramLabel}</a>
            <a href={`mailto:${siteSettings.contactEmail}`}>{siteSettings.contactEmail}</a>
            <a class="admin-link" href="/admin/">{siteSettings.footer.adminLabel}</a>
          </div>
        </div>
      </div>
      <div class="wrap footer-note">{siteSettings.footer.note}</div>
    </footer>

    <script is:inline>
      (function () {
        var EMAIL = document.body.dataset.contactEmail || "youthconservation26@gmail.com";

        function reveal() {
          if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.querySelectorAll("[data-reveal]").forEach(function (el) {
              el.classList.add("is-visible");
            });
            return;
          }
          if (!("IntersectionObserver" in window)) {
            document.querySelectorAll("[data-reveal]").forEach(function (el) {
              el.classList.add("is-visible");
            });
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              });
            },
            { threshold: 0.1, rootMargin: "0px 0px -6% 0px" }
          );
          document.querySelectorAll("[data-reveal]").forEach(function (el) {
            io.observe(el);
          });
        }

        function setupContactForm() {
          var form = document.getElementById("contact-form");
          var success = document.getElementById("contact-success");
          var reset = document.getElementById("contact-reset");
          if (!form || !success || !reset) return;

          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var data = new FormData(form);
            var subject = "BAYC website: " + (data.get("topic") || "Question");
            var body =
              "Name: " +
              data.get("name") +
              "\nEmail: " +
              data.get("email") +
              "\nTopic: " +
              data.get("topic") +
              "\n\n" +
              data.get("message");
            window.location.href =
              "mailto:" +
              EMAIL +
              "?subject=" +
              encodeURIComponent(subject) +
              "&body=" +
              encodeURIComponent(body);
            form.hidden = true;
            success.hidden = false;
          });

          reset.addEventListener("click", function () {
            form.reset();
            form.hidden = false;
            success.hidden = true;
          });
        }

        reveal();
        setupContactForm();
      })();
    </script>
    <script src="/mobile-nav.js" defer></script>
  </body>
</html>

<style is:global>
  :root {
    --green-deep: #2E4A24;
    --green-deeper: #1E3418;
    --green-eyebrow: #456B2C;
    --lime-pale: #F5FAEE;
    --lime-soft: #DCF2C4;
    --lime-bright: #CBF5A0;
    --turquoise: #65E0DD;
    --olive: #6B6533;
    --ink: #26261F;
    --ink-body: #4F4F47;
    --ink-muted: #55554D;
    --hair: rgba(0, 0, 0, 0.07);
    --ease: cubic-bezier(.25, .46, .45, .94);
    --font-display: "Bitter", Georgia, serif;
    --font-body: "Plus Jakarta Sans", system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: #fff;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: hidden;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--lime-bright);
  }

  a {
    color: var(--green-deep);
    text-decoration: none;
  }

  a:hover {
    color: var(--green-deeper);
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--turquoise);
    outline-offset: 3px;
  }

  button,
  input,
  textarea,
  select {
    font-family: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  [hidden] {
    display: none !important;
  }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
  }

  .wrap-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    max-width: 1240px;
    min-height: 68px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
  }

  .sec {
    padding: clamp(64px, 8vw, 110px) clamp(20px, 4vw, 56px);
  }

  .sec-sm {
    padding: clamp(48px, 6vw, 84px) clamp(20px, 4vw, 56px);
  }

  .band-pale {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: var(--lime-pale);
  }

  .band-green {
    background: var(--green-deep);
  }

  .eyebrow {
    color: var(--green-eyebrow);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kicker {
    color: var(--olive);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1.display,
  h1.page,
  h2.sect,
  .card-heading,
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--green-deep);
    letter-spacing: 0;
  }

  h1.display {
    margin: 26px 0 0;
    font-size: clamp(36px, 5.4vw, 62px);
    line-height: 1.08;
  }

  h1.page {
    margin: 14px 0 0;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.1;
  }

  h2.sect {
    margin: 14px 0 0;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.15;
  }

  .card-heading {
    margin: 12px 0 0;
    font-size: 20px;
  }

  .card-title {
    margin: 12px 0 0;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
  }

  .card-title.small {
    font-size: 21px;
  }

  .lede {
    color: var(--ink-body);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.65;
  }

  .body {
    color: var(--ink-body);
    font-size: 16.5px;
    line-height: 1.75;
  }

  .body-sm {
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .body,
  .body-sm {
    margin: 12px 0 0;
  }

  .btn,
  .btn-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    cursor: pointer;
    font-weight: 600;
    transition:
      background 200ms var(--ease),
      border-color 200ms var(--ease),
      color 200ms var(--ease);
  }

  .btn {
    min-height: 48px;
    padding: 13px 26px;
    border: none;
    font-size: 15px;
  }

  .btn-primary {
    background: var(--green-deep);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--green-deeper);
    color: #fff;
  }

  .btn-ghost {
    border: 1px solid rgba(46, 74, 36, 0.3);
    background: #fff;
    color: var(--green-deep);
  }

  .btn-ghost:hover {
    border-color: var(--turquoise);
  }

  .btn-on-green {
    background: #fff;
    color: var(--green-deep);
  }

  .btn-on-green:hover {
    background: #E4F7C9;
  }

  .link-btn {
    display: inline-flex;
    padding: 0 0 2px;
    border-bottom: 1px solid rgba(46, 74, 36, 0.35);
    background: none;
    color: var(--green-deep);
    font-size: 15px;
    font-weight: 600;
  }

  .link-btn:hover {
    border-bottom-color: var(--turquoise);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--hair);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: contain;
  }

  .brand span {
    color: var(--green-deep);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.8vw, 26px);
    flex-wrap: wrap;
    padding: 8px 0;
  }

  .navlink {
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    color: #3D3D36;
    font-size: 14.5px;
    font-weight: 500;
  }

  .navlink[aria-current="page"] {
    border-bottom-color: var(--green-deep);
  }

  .btn-nav {
    min-height: 39px;
    padding: 9px 20px;
    background: var(--green-deep);
    color: #fff;
    font-size: 14.5px;
  }

  .btn-nav:hover {
    background: var(--green-deeper);
    color: #fff;
  }

  .btn-nav[aria-current="page"] {
    box-shadow: inset 0 0 0 2px var(--turquoise);
  }

  .card {
    padding: 26px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: box-shadow 200ms var(--ease);
  }

  .card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .card-lg {
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .grid {
    display: grid;
    gap: 20px;
  }

  .grid-4 {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .grid-3 {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .grid-team {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 24px;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .frame {
    padding: 12px;
    border-radius: 22px;
    background: var(--lime-soft);
  }

  .frame img,
  .photo {
    display: block;
    width: 100%;
    border-radius: 16px;
    background: var(--lime-pale);
    object-fit: cover;
  }

  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    padding: 16px;
    border: 1px dashed rgba(46, 74, 36, 0.3);
    border-radius: 16px;
    background: var(--lime-pale);
    color: var(--olive);
    font-size: 13px;
    text-align: center;
  }

  .home-hero {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: var(--lime-pale);
    padding-top: clamp(56px, 9vw, 110px);
    padding-bottom: clamp(52px, 8vw, 96px);
  }

  .home-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 7px 15px;
    border: 1px solid rgba(46, 74, 36, 0.22);
    border-radius: 9999px;
    background: #fff;
  }

  .home-hero .lede {
    max-width: 640px;
    margin: 22px auto 0;
  }

  .cta-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .highlight-band {
    padding: clamp(40px, 5vw, 60px) clamp(20px, 4vw, 56px);
  }

  .highlight-band h2 {
    margin: 0;
    color: #F2F5F0;
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(20px, 3vw, 36px);
    margin-top: 32px;
  }

  .highlight-grid article {
    padding: 0 12px;
    text-align: center;
  }

  .highlight-grid article + article {
    border-left: 1px solid rgba(101, 224, 221, 0.4);
  }

  .highlight-grid strong {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.1;
  }

  .highlight-grid p {
    margin: 8px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 14.5px;
    line-height: 1.55;
  }

  .split .body {
    margin-top: 20px;
  }

  .split .link-btn {
    margin-top: 24px;
  }

  .about-photo {
    min-height: clamp(280px, 32vw, 420px);
  }

  .card-stack {
    margin-top: 44px;
  }

  .card .body-sm {
    margin-top: 10px;
  }

  .ask-band {
    text-align: center;
  }

  .ask-band > div {
    max-width: 880px;
    margin: 0 auto;
  }

  .ask-band .sect {
    font-size: clamp(26px, 3.2vw, 40px);
  }

  .ask-band .body {
    max-width: 600px;
    margin: 18px auto 0;
  }

  .ask-band .btn {
    margin-top: 28px;
  }

  .work-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 1000px;
  }

  .work-list .body {
    max-width: 640px;
    font-size: 16px;
    line-height: 1.7;
  }

  .social-section {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .social-frame {
    margin-top: 32px;
  }

  .social-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    background: #fff;
    object-fit: initial;
  }

  .social-link {
    margin-top: 20px;
  }

  .team-card {
    text-align: center;
  }

  .team-card .kicker {
    margin-top: 16px;
  }

  .team-card h2 {
    margin: 6px 0 0;
    color: var(--green-deep);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .team-photo {
    aspect-ratio: 1.3 / 1;
    min-height: 260px;
  }

  .placeholder-note {
    margin-top: 36px;
    padding: 20px 24px;
    border: 1px solid var(--hair);
    border-radius: 14px;
    background: var(--lime-pale);
    color: var(--ink-body);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .involvement-grid {
    gap: 22px;
  }

  .involvement-grid .card {
    padding: 28px;
  }

  .collaborate-band {
    padding: clamp(56px, 7vw, 96px) clamp(20px, 4vw, 56px);
    text-align: center;
  }

  .collaborate-band > div {
    max-width: 820px;
    margin: 0 auto;
  }

  .green-eyebrow {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .collaborate-band h2 {
    margin: 14px 0 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.14;
  }

  .collaborate-band p {
    max-width: 620px;
    margin: 20px auto 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 16.5px;
    line-height: 1.7;
  }

  .collaborate-band .btn {
    margin-top: 30px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    align-items: start;
    gap: clamp(32px, 5vw, 64px);
    max-width: 1040px;
    margin: 0 auto;
  }

  #contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  #contact-form .btn {
    align-self: flex-start;
  }

  .form-note {
    margin: 0;
    color: var(--olive);
    font-size: 13px;
    line-height: 1.6;
  }

  .contact-success {
    padding: 28px;
    border: 1px solid rgba(46, 74, 36, 0.18);
    border-radius: 16px;
    background: var(--lime-soft);
  }

  .contact-success h2 {
    margin: 0;
    color: var(--green-deep);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .contact-success p {
    margin: 12px 0 0;
    color: #3D4A33;
    font-size: 15px;
    line-height: 1.7;
  }

  .contact-success .link-btn {
    margin-top: 18px;
  }

  .contact-card {
    padding: 28px;
    border: 1px solid var(--hair);
    border-radius: 18px;
    background: var(--lime-pale);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 18px;
  }

  .contact-links a {
    font-size: 15.5px;
    font-weight: 600;
  }

  .contact-location {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .contact-location .body {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.7;
  }

  .page-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: var(--lime-pale);
    text-align: center;
  }

  .page-header-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .page-header .body {
    max-width: 620px;
    margin: 20px auto 0;
  }

  .section-intro {
    max-width: 720px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .field span {
    color: var(--olive);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .field input,
  .field select,
  .field textarea {
    padding: 12px 14px;
    border: 1px solid rgba(0, 0, 0, 0.16);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    font-size: 15px;
    outline: none;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--green-deep);
  }

  .field textarea {
    line-height: 1.6;
    resize: vertical;
  }

  html.js [data-reveal] {
    opacity: 0;
