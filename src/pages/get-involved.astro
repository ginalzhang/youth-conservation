---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getInvolvedPage } from "../lib/content";
---

<BaseLayout
  title={getInvolvedPage.title}
  description={getInvolvedPage.description}
  currentPath="/get-involved/"
>
  <main>
    <section class="sec-sm page-header">
      <div class="page-header-inner">
        <div class="eyebrow">{getInvolvedPage.header.eyebrow}</div>
        <h1 class="page">{getInvolvedPage.header.heading}</h1>
        <p class="body">{getInvolvedPage.header.body}</p>
      </div>
    </section>

    <section class="sec-sm">
      <div class="wrap grid grid-3 involvement-grid" data-reveal>
        {
          getInvolvedPage.cards.map((card) => (
            <article class="card">
              <div class="kicker">{card.kicker}</div>
              <h2 class="card-title small">{card.heading}</h2>
              <p class="body-sm">{card.body}</p>
              {card.linkHref && card.linkLabel ? (
                <a
                  class="involvement-link"
                  href={card.linkHref}
                  target={card.newTab ? "_blank" : undefined}
                  rel={card.newTab ? "noopener noreferrer" : undefined}
                >
                  {card.linkLabel}
                </a>
              ) : null}
            </article>
          ))
        }
      </div>
    </section>

    <section id="calendar" class="sec-sm band-pale" style="scroll-margin-top:80px">
      <div class="wrap">
        <div style="max-width:720px" data-reveal>
          <div class="eyebrow">Calendar</div>
          <h2 class="sect">What is coming up.</h2>
          <p class="body" style="margin:16px 0 0;font-size:16px;line-height:1.7">
            Workshops, volunteer days, and clean ups go on here as soon as they are scheduled. No sign up needed to look.
          </p>
        </div>
        <div class="cal-frame" data-reveal>
          <iframe
            class="cal-embed"
            src="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=America%2FLos_Angeles&showPrint=0&showTitle=0&showCalendars=0&showTz=0&mode=AGENDA&bgcolor=%23ffffff&src=M2I0YTRjY2FkNjkyNzQzNTUxNzA1NzdjZGEzMTBhMmFmYThiZTA0MWI3NmViMWU4ZjQxYTY2N2E0NjA3MzM3NkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%230b8043"
            title="Bay Area Youth Conservation events calendar"
            loading="lazy"
          ></iframe>
        </div>
        <p class="body-sm" style="margin:16px 0 0">
          Times are Pacific.{" "}
          <a
            href="https://calendar.google.com/calendar/embed?src=M2I0YTRjY2FkNjkyNzQzNTUxNzA1NzdjZGEzMTBhMmFmYThiZTA0MWI3NmViMWU4ZjQxYTY2N2E0NjA3MzM3NkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t&ctz=America%2FLos_Angeles"
            target="_blank"
            rel="noopener"
            style="font-weight:600"
          >
            Open in Google Calendar
          </a>{" "}
          to add it to your own.
        </p>
      </div>
    </section>

    <section class="band-green collaborate-band">
      <div data-reveal>
        <div class="green-eyebrow">{getInvolvedPage.collaboration.eyebrow}</div>
        <h2>{getInvolvedPage.collaboration.heading}</h2>
        <p>{getInvolvedPage.collaboration.body}</p>
        <a class="btn btn-on-green" href={getInvolvedPage.collaboration.cta.href}>
          {getInvolvedPage.collaboration.cta.label}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .involvement-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 600;
  }
</style>
