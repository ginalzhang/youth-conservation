---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getInvolvedPage } from "../lib/content";
---

<BaseLayout
  title={getInvolvedPage.title}
  description={getInvolvedPage.description}
  currentPath="/get-involved/"
>
  <main>
    <section class="sec-sm page-header">
      <div class="page-header-inner">
        <div class="eyebrow">{getInvolvedPage.header.eyebrow}</div>
        <h1 class="page">{getInvolvedPage.header.heading}</h1>
        <p class="body">{getInvolvedPage.header.body}</p>
      </div>
    </section>

    <section class="sec-sm">
      <div class="wrap grid grid-3 involvement-grid" data-reveal>
        <article class="card">
          <div class="kicker">Step one</div>
          <h2 class="card-title small">Turn notifications on</h2>
          <p class="body-sm">
            Turn notifications on for our page to get instant updates on volunteering and workshop events. Make sure to <strong>show up</strong> whenever you can (most important part) to volunteering events, meetings, etc.
          </p>
          <a class="involvement-link" href="https://www.instagram.com/youth_conservation/" target="_blank" rel="noopener noreferrer">
            Follow @youth_conservation
          </a>
        </article>
        <article class="card">
          <div class="kicker">Step two</div>
          <h2 class="card-title small">Start a chapter or club</h2>
          <p class="body-sm">
            Develops leadership skills while creating impact within your community. We are open to applicants around the nation and worldwide.
          </p>
          <a class="involvement-link" href="/start-a-chapter/">
            Start a chapter
          </a>
        </article>
        <article class="card">
          <div class="kicker">Step three</div>
          <h2 class="card-title small">DM us for collaborations</h2>
          <p class="body-sm">
            Message us about collaborations and upcoming clean ups. We work with schools, clubs, libraries, and local groups to bring youth conservation projects and education to more people.
          </p>
          <a class="involvement-link" href="https://www.instagram.com/youth_conservation/" target="_blank" rel="noopener noreferrer">
            Send us a DM
          </a>
        </article>
      </div>
    </section>

    <section class="band-green collaborate-band">
      <div data-reveal>
        <div class="green-eyebrow">{getInvolvedPage.collaboration.eyebrow}</div>
        <h2>{getInvolvedPage.collaboration.heading}</h2>
        <p>{getInvolvedPage.collaboration.body}</p>
        <a class="btn btn-on-green" href={getInvolvedPage.collaboration.cta.href}>
          {getInvolvedPage.collaboration.cta.label}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .involvement-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 600;
  }
</style>
