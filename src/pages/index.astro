---
const navItems = [
  { label: "About", href: "#about" },
  { label: "Work", href: "#work" },
  { label: "Activities", href: "#activities" },
  { label: "Impact", href: "#impact" },
  { label: "Collab", href: "#collaborate" },
  { label: "Contact", href: "#contact" }
];

const workCards = [
  {
    title: "Workshops",
    text: "We host community workshops every two months at San Leandro Library, with youth-friendly topics that make local environmental action easier to understand.",
    tag: "Every 2 months"
  },
  {
    title: "Volunteer Opportunities",
    text: "We connect students with conservation-minded service opportunities that support neighborhoods, outdoor spaces, and community awareness.",
    tag: "Take action"
  },
  {
    title: "Education Posts",
    text: "Through short, accessible posts, we share climate facts, sustainability tips, and conservation ideas students can use in everyday life.",
    tag: "Learn locally"
  },
  {
    title: "Collaborations",
    text: "We work with schools, clubs, libraries, and local groups to bring youth conservation projects and education to more people.",
    tag: "Partner up"
  }
];

const activities = [
  {
    title: "Library Workshops",
    text: "Join the every-two-month workshop series at San Leandro Library for climate learning, hands-on projects, and conversation.",
    meta: "San Leandro Library"
  },
  {
    title: "Community Volunteering",
    text: "Take part in local opportunities that help students contribute time, energy, and care to the places around them.",
    meta: "Youth service"
  },
  {
    title: "Climate Education",
    text: "Follow along for student-centered posts about recycling, conservation, sustainability, and environmental action.",
    meta: "@youth_conservation"
  }
];

const impactItems = [
  {
    value: "Youth-led",
    label: "Built by students for students, families, and local neighbors."
  },
  {
    value: "2 months",
    label: "Workshop rhythm at San Leandro Library."
  },
  {
    value: "East Bay",
    label: "Focused on San Leandro, San Lorenzo, and nearby communities."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Bay Area Youth Conservation is a youth-led group bringing climate education, community workshops, and conservation action to San Leandro, San Lorenzo, and nearby Bay Area communities."
    />
    <title>Bay Area Youth Conservation</title>
    <link rel="icon" type="image/png" href="/assets/bayc-logo.png" />
  </head>
  <body>
    <header class="site-header" aria-label="Primary navigation">
      <a class="brand" href="#top" aria-label="Bay Area Youth Conservation home">
        <img src="/assets/bayc-logo.png" alt="" width="52" height="52" />
        <span>Bay Area Youth Conservation</span>
      </a>
      <nav>
        <ul>
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="nav-cta" href="mailto:youthconservation26@gmail.com">Email Us</a>
    </header>

    <main id="top">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Youth-led conservation in the Bay Area</p>
          <h1 id="hero-title">Helping local students turn climate care into community action.</h1>
          <p class="hero-text">
            Bay Area Youth Conservation brings young people together through climate education,
            hands-on volunteer opportunities, and community workshops in the San Leandro and San Lorenzo area.
          </p>
          <div class="cta-row" aria-label="Primary actions">
            <a class="button button-primary" href="#activities">Join a Workshop</a>
            <a class="button button-secondary" href="#contact">Contact Us</a>
          </div>
        </div>

        <div class="hero-art" aria-label="Bay Area Youth Conservation visual identity">
          <div class="hero-logo-card">
            <img src="/assets/bayc-logo.png" alt="Bay Area Youth Conservation hummingbird logo" />
          </div>
          <div class="floating-note note-a">
            <span>Workshops</span>
            <strong>Every 2 months</strong>
          </div>
          <div class="floating-note note-b">
            <span>Focus area</span>
            <strong>San Leandro + San Lorenzo</strong>
          </div>
        </div>
      </section>

      <section class="intro-band" id="about" aria-labelledby="about-title">
        <div class="section-shell split">
          <div>
            <p class="eyebrow">Who We Are</p>
            <h2 id="about-title">A youth group making conservation approachable.</h2>
          </div>
          <p>
            Bay Area Youth Conservation is focused on making conservation approachable for
            students, families, and local neighbors. We share climate education, create space
            for youth involvement, and connect people with practical ways to care for the Bay
            Area environment, starting in San Leandro and San Lorenzo.
          </p>
        </div>
      </section>

      <section class="section-shell" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="eyebrow">What We Do</p>
          <h2 id="work-title">Education, service, and local partnerships.</h2>
        </div>
        <div class="card-grid">
          {workCards.map((card) => (
            <article class="work-card">
              <span>{card.tag}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="activities-band" id="activities" aria-labelledby="activities-title">
        <div class="section-shell activities-layout">
          <div class="section-heading">
            <p class="eyebrow">Upcoming / Recent Activities</p>
            <h2 id="activities-title">A community feed, built for real-world action.</h2>
            <p>
              BAYC shares workshop announcements, recaps, and simple conservation education
              through Instagram-style posts that are easy for students to follow and share.
            </p>
          </div>

          <div class="feed-preview">
            <img
              src="/assets/bayc-social-reference.png"
              alt="A collage of Bay Area Youth Conservation social media posts about workshops, recycling, and local activities"
              loading="lazy"
            />
          </div>

          <div class="activity-cards">
            {activities.map((activity) => (
              <article class="activity-card">
                <p>{activity.meta}</p>
                <h3>{activity.title}</h3>
                <span>{activity.text}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section-shell impact" id="impact" aria-labelledby="impact-title">
        <div class="section-heading">
          <p class="eyebrow">Impact Snapshot</p>
          <h2 id="impact-title">Rooted in local youth action.</h2>
          <p>
            These are current factual highlights from BAYC's existing public materials, not
            inflated impact claims.
          </p>
        </div>
        <div class="impact-grid">
          {impactItems.map((item) => (
            <article>
              <strong>{item.value}</strong>
              <p>{item.label}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="collab-band" id="collaborate" aria-labelledby="collab-title">
        <div class="section-shell collab">
          <div>
            <p class="eyebrow">Collaborate With Us</p>
            <h2 id="collab-title">Bring youth conservation education to your community space.</h2>
          </div>
          <div>
            <p>
              Bay Area Youth Conservation is open to local collaborations, workshop ideas,
              volunteer projects, and education partnerships across the San Leandro and San Lorenzo area.
            </p>
            <a class="button button-primary" href="mailto:youthconservation26@gmail.com">Start a Collaboration</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="contact">
      <div class="section-shell footer-grid">
        <div>
          <img src="/assets/bayc-logo.png" alt="Bay Area Youth Conservation logo" width="84" height="84" />
          <h2>Bay Area Youth Conservation</h2>
          <p>
            Youth-led climate education and conservation action in the Bay Area, with a focus
            on San Leandro and San Lorenzo.
          </p>
        </div>
        <address>
          <span>Get in touch</span>
          <a href="https://www.instagram.com/youth_conservation/">Instagram @youth_conservation</a>
          <a href="mailto:youthconservation26@gmail.com">youthconservation26@gmail.com</a>
        </address>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --aqua: #8be3e2;
    --pale-green: #d1f7ac;
    --leaf: #93bb74;
    --olive: #95925b;
    --olive-ink: #62602f;
    --deep-green: #4c7031;
    --off-white: #f6fff0;
    --ink: #203819;
    --paper: #fffdf0;
    --line: rgba(76, 112, 49, 0.18);
    --shadow: 0 24px 70px rgba(45, 73, 34, 0.18);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--off-white);
  }

  body {
    margin: 0;
    color: var(--ink);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at 12% 18%, rgba(139, 227, 226, 0.55), transparent 26rem),
      linear-gradient(180deg, var(--off-white) 0%, #ffffff 44%, var(--off-white) 100%);
    line-height: 1.6;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
    opacity: 0.24;
    background-image:
      linear-gradient(rgba(76, 112, 49, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(76, 112, 49, 0.08) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .section-shell {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: min(1160px, calc(100% - 28px));
    min-height: 74px;
    margin: 14px auto 0;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(246, 255, 240, 0.9);
    box-shadow: 0 12px 36px rgba(32, 56, 25, 0.1);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 10px;
    color: var(--deep-green);
    font-weight: 850;
    line-height: 1.1;
    text-decoration: none;
  }

  .brand img {
    width: 52px;
    height: 52px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  nav a,
  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    background: rgba(147, 187, 116, 0.2);
  }

  .nav-cta {
    background: var(--deep-green);
    color: white;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.78fr);
    align-items: center;
    gap: 56px;
    min-height: calc(100vh - 190px);
    padding: 44px 0 58px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.02;
    letter-spacing: 0;
  }

  h1 {
    max-width: 770px;
    font-size: clamp(3rem, 6vw, 5.45rem);
    color: var(--deep-green);
  }

  h2 {
    font-size: clamp(2.1rem, 4vw, 4.2rem);
    color: var(--deep-green);
  }

  h3 {
    color: var(--deep-green);
    font-size: 1.35rem;
  }

  .hero-text {
    max-width: 660px;
    margin: 24px 0 0;
    color: rgba(32, 56, 25, 0.82);
    font-size: clamp(1.06rem, 1.9vw, 1.28rem);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    border: 2px solid var(--deep-green);
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
  }

  .button-primary {
    background: var(--deep-green);
    color: white;
    box-shadow: 0 14px 28px rgba(76, 112, 49, 0.24);
  }

  .button-secondary {
    background: rgba(255, 255, 255, 0.54);
    color: var(--deep-green);
  }

  .hero-art {
    position: relative;
    min-height: 500px;
  }

  .hero-logo-card {
    position: absolute;
    inset: 42px 20px auto auto;
    width: min(440px, 100%);
    padding: clamp(20px, 4vw, 34px);
    border: 1px solid rgba(76, 112, 49, 0.2);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(246, 255, 240, 0.94), rgba(255, 255, 255, 0.68)),
      var(--off-white);
    box-shadow: var(--shadow);
    transform: rotate(2deg);
  }

  .hero-logo-card::before,
  .feed-preview::before {
    position: absolute;
    top: 16px;
    left: 50%;
    width: 108px;
    height: 28px;
    content: "";
    background: rgba(149, 146, 91, 0.36);
    transform: translateX(-50%) rotate(-3deg);
  }

  .hero-logo-card img {
    width: 100%;
    border-radius: 8px;
  }

  .floating-note {
    position: absolute;
    display: grid;
    gap: 3px;
    width: 198px;
    padding: 18px;
    border: 1px solid rgba(76, 112, 49, 0.16);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: 0 16px 38px rgba(32, 56, 25, 0.14);
  }

  .floating-note span {
    color: var(--olive-ink);
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .floating-note strong {
    color: var(--deep-green);
    font-size: 1.15rem;
    line-height: 1.12;
  }

  .note-a {
    top: 6px;
    left: 2px;
    background: var(--pale-green);
    transform: rotate(-5deg);
  }

  .note-b {
    right: 0;
    bottom: 20px;
    background: var(--aqua);
    transform: rotate(4deg);
  }

  .intro-band,
  .activities-band,
  .collab-band {
    padding: 86px 0;
  }

  .intro-band {
    background: var(--deep-green);
    color: var(--off-white);
  }

  .intro-band .eyebrow,
  .intro-band h2 {
    color: var(--off-white);
  }

  .split,
  .collab {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  .split p:last-child,
  .collab p {
    margin: 0;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
  }

  .section-heading {
    max-width: 740px;
    margin-bottom: 34px;
  }

  .section-heading p:not(.eyebrow) {
    margin: 16px 0 0;
    color: rgba(32, 56, 25, 0.76);
    font-size: 1.05rem;
  }

  #work,
  .impact {
    padding: 96px 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .work-card,
  .activity-card,
  .impact-grid article {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 16px 38px rgba(32, 56, 25, 0.08);
  }

  .work-card {
    min-height: 278px;
    padding: 24px;
  }

  .work-card:nth-child(2) {
    background: rgba(209, 247, 172, 0.42);
  }

  .work-card:nth-child(3) {
    background: rgba(139, 227, 226, 0.36);
  }

  .work-card span {
    display: inline-flex;
    margin-bottom: 34px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(76, 112, 49, 0.1);
    color: var(--deep-green);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .work-card p {
    margin: 18px 0 0;
    color: rgba(32, 56, 25, 0.74);
  }

  .activities-band {
    background:
      linear-gradient(90deg, rgba(209, 247, 172, 0.72), rgba(139, 227, 226, 0.48)),
      var(--pale-green);
  }

  .activities-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(280px, 0.58fr);
    gap: 34px;
    align-items: start;
  }

  .feed-preview {
    position: relative;
    grid-column: 1 / -1;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(76, 112, 49, 0.2);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: var(--shadow);
    transform: rotate(0.7deg);
  }

  .feed-preview img {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: left top;
  }

  .activity-cards {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .activity-card {
    min-height: 216px;
    padding: 24px;
    background: var(--paper);
  }

  .activity-card p {
    margin: 0 0 24px;
    color: var(--olive-ink);
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .activity-card span {
    display: block;
    margin-top: 14px;
    color: rgba(32, 56, 25, 0.74);
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .impact-grid article {
    padding: 28px;
    background: var(--deep-green);
    color: var(--off-white);
  }

  .impact-grid strong {
    display: block;
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 1;
  }

  .impact-grid p {
    margin: 18px 0 0;
    color: rgba(246, 255, 240, 0.84);
  }

  .collab-band {
    background:
      linear-gradient(110deg, rgba(139, 227, 226, 0.9), rgba(245, 179, 106, 0.34)),
      var(--aqua);
  }

  .collab {
    align-items: center;
  }

  .collab .button {
    margin-top: 24px;
  }

  .site-footer {
    padding: 64px 0 44px;
    background: #243f1a;
    color: var(--off-white);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.45fr);
    gap: 36px;
  }

  .footer-grid img {
    border-radius: 50%;
    background: var(--off-white);
  }

  .footer-grid h2 {
    margin-top: 18px;
    color: var(--off-white);
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .footer-grid p {
    max-width: 620px;
    color: rgba(246, 255, 240, 0.76);
  }

  address {
    display: grid;
    align-content: start;
    gap: 14px;
    font-style: normal;
  }

  address span {
    color: var(--aqua);
    font-size: 0.85rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  address a {
    color: var(--off-white);
    font-weight: 800;
  }

  @media (max-width: 940px) {
    .site-header {
      align-items: flex-start;
      border-radius: 28px;
      flex-wrap: wrap;
    }

    nav {
      order: 3;
      width: 100%;
    }

    nav ul {
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero,
    .split,
    .collab,
    .activities-layout,
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      gap: 20px;
      min-height: auto;
      padding: 44px 0 58px;
    }

    .hero-art {
      min-height: 420px;
    }

    .hero-logo-card {
      inset: 48px 0 auto auto;
      width: min(400px, 92%);
    }

    .card-grid,
    .activity-cards,
    .impact-grid {
      grid-template-columns: 1fr 1fr;
    }

    .feed-preview,
    .feed-preview img {
      min-height: 0;
      height: auto;
    }
  }

  @media (max-width: 640px) {
    .section-shell {
      width: min(100% - 28px, 1120px);
    }

    .site-header {
      width: min(100% - 20px, 1160px);
      gap: 10px;
    }

    .brand span {
      max-width: 168px;
      font-size: 0.92rem;
    }

    .brand img {
      width: 46px;
      height: 46px;
    }

    .nav-cta {
      min-height: 38px;
      padding: 0 12px;
      font-size: 0.86rem;
      white-space: nowrap;
    }

    nav a {
      min-height: 36px;
      padding: 0 10px;
      font-size: 0.84rem;
    }

    h1 {
      font-size: clamp(2.55rem, 12.7vw, 3.9rem);
    }

    .hero {
      padding-bottom: 44px;
    }

    .button {
      width: 100%;
    }

    .hero-art {
      display: none;
    }

    .floating-note {
      width: 168px;
      padding: 14px;
    }

    .note-b {
      right: 4px;
    }

    .card-grid,
    .activity-cards,
    .impact-grid {
      grid-template-columns: 1fr;
    }

    .intro-band,
    .activities-band,
    .collab-band,
    #work,
    .impact {
      padding: 68px 0;
    }

    .work-card,
    .activity-card {
      min-height: auto;
    }
  }
</style>
