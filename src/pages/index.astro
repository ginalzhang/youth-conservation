<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Bay Area Youth Conservation</title>
<meta name="description" content="Youth-led climate education, workshops, and volunteer opportunities in San Leandro, San Lorenzo, and the East Bay." />
<link rel="icon" type="image/png" href="/assets/bayc-logo.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root {
    --green-deep: #2E4A24;
    --green-deeper: #1E3418;
    --green-eyebrow: #456B2C;
    --lime-pale: #F5FAEE;
    --lime-soft: #DCF2C4;
    --lime-bright: #CBF5A0;
    --turquoise: #65E0DD;
    --olive: #6B6533;
    --ink: #26261F;
    --ink-body: #4F4F47;
    --ink-muted: #55554D;
    --hair: rgba(0,0,0,0.07);
    --ease: cubic-bezier(.25,.46,.45,.94);
    --font-display: "Bitter", Georgia, serif;
    --font-body: "Plus Jakarta Sans", system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin:0; background:#fff; color:var(--ink); font-family:var(--font-body); -webkit-font-smoothing:antialiased; text-wrap:pretty; overflow-x:hidden; }
  a { color:var(--green-deep); text-decoration:none; }
  a:hover { color:var(--green-deeper); }
  button, input, textarea, select { font-family:inherit; }
  ::selection { background:var(--lime-bright); }

  /* Layout */
  .wrap { max-width:1180px; margin:0 auto; }
  .wrap-nav { max-width:1240px; margin:0 auto; padding:0 clamp(20px,4vw,56px); min-height:68px; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .sec { padding: clamp(64px,8vw,110px) clamp(20px,4vw,56px); }
  .sec-sm { padding: clamp(48px,6vw,84px) clamp(20px,4vw,56px); }
  .band-pale { background:var(--lime-pale); border-top:1px solid rgba(0,0,0,0.06); border-bottom:1px solid rgba(0,0,0,0.06); }
  .band-green { background:var(--green-deep); }

  /* Type */
  .eyebrow { font-size:12px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--green-eyebrow); }
  .kicker { font-size:11.5px; font-weight:600; letter-spacing:.09em; text-transform:uppercase; color:var(--olive); }
  h1.display { font-family:var(--font-display); font-weight:700; font-size:clamp(36px,5.4vw,62px); line-height:1.08; letter-spacing:-.02em; color:var(--green-deep); margin:26px 0 0; }
  h1.page { font-family:var(--font-display); font-weight:700; font-size:clamp(32px,4.4vw,52px); line-height:1.1; letter-spacing:-.02em; color:var(--green-deep); margin:14px 0 0; }
  h2.sect { font-family:var(--font-display); font-weight:700; font-size:clamp(28px,3.4vw,42px); line-height:1.15; letter-spacing:-.02em; color:var(--green-deep); margin:14px 0 0; }
  .card-title { font-family:var(--font-display); font-weight:700; font-size:20px; color:var(--green-deep); margin:12px 0 0; letter-spacing:-.01em; }
  .lede { font-size:clamp(16px,1.3vw,18px); line-height:1.65; color:var(--ink-body); }
  .body { font-size:16.5px; line-height:1.75; color:var(--ink-body); }
  .body-sm { font-size:15px; line-height:1.65; color:var(--ink-muted); }

  /* Buttons */
  .btn { display:inline-block; font-size:15px; font-weight:600; padding:13px 26px; border-radius:9999px; border:none; cursor:pointer; transition:background 200ms var(--ease), border-color 200ms var(--ease); }
  .btn-primary { background:var(--green-deep); color:#fff; }
  .btn-primary:hover { background:var(--green-deeper); color:#fff; }
  .btn-ghost { background:#fff; color:var(--green-deep); border:1px solid rgba(46,74,36,.3); }
  .btn-ghost:hover { border-color:var(--turquoise); }
  .btn-onGreen { background:#fff; color:var(--green-deep); }
  .btn-onGreen:hover { background:#E4F7C9; }
  .btn-nav { background:var(--green-deep); color:#fff; font-size:14.5px; font-weight:600; padding:9px 20px; border:none; border-radius:9999px; cursor:pointer; transition:background 200ms var(--ease); }
  .btn-nav:hover { background:var(--green-deeper); }
  .link-btn { background:none; border:none; padding:0; cursor:pointer; font-size:15px; font-weight:600; color:var(--green-deep); border-bottom:1px solid rgba(46,74,36,.35); }
  .link-btn:hover { border-bottom-color:var(--turquoise); }

  /* Nav */
  header.site { position:sticky; top:0; z-index:50; --nav-anchor:1; background:rgba(255,255,255,.9); backdrop-filter:blur(12px); border-bottom:1px solid var(--hair); }
  .brand { display:flex; align-items:center; gap:10px; flex-shrink:0; background:none; border:none; padding:0; cursor:pointer; text-align:left; }
  .brand img { width:34px; height:34px; border-radius:50%; object-fit:contain; }
  .brand span { font-family:var(--font-display); font-weight:700; font-size:17px; letter-spacing:-.015em; color:var(--green-deep); line-height:1.1; }
  nav.site { display:flex; align-items:center; gap:clamp(12px,1.8vw,26px); flex-wrap:wrap; padding:8px 0; }
  .navlink { background:none; border:none; padding:4px 0; cursor:pointer; font-size:14.5px; font-weight:500; color:#3D3D36; border-bottom:2px solid transparent; }
  .navlink[aria-current="page"] { border-bottom-color:var(--green-deep); }

  /* Cards */
  .card { background:#fff; border:1px solid rgba(0,0,0,.07); border-radius:16px; padding:26px; box-shadow:0 1px 2px rgba(0,0,0,.04); transition:box-shadow 200ms var(--ease); }
  .card:hover { box-shadow:0 8px 24px rgba(0,0,0,.08); }
  .card-lg { background:#fff; border:1px solid rgba(0,0,0,.07); border-radius:18px; padding:clamp(24px,3vw,36px); box-shadow:0 1px 2px rgba(0,0,0,.04); }
  .grid { display:grid; gap:20px; }
  .grid-4 { grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); }
  .grid-3 { grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); }
  .grid-team { grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:24px; }
  .split { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(32px,5vw,72px); align-items:center; }

  /* Photo frames */
  .frame { padding:12px; background:var(--lime-soft); border-radius:22px; }
  .frame img, .photo { width:100%; display:block; border-radius:16px; object-fit:cover; background:var(--lime-pale); }
  .photo-placeholder { display:flex; align-items:center; justify-content:center; border:1px dashed rgba(46,74,36,.3); border-radius:16px; background:var(--lime-pale); color:var(--olive); font-size:13px; text-align:center; padding:16px; }

  /* Forms */
  .field { display:flex; flex-direction:column; gap:7px; }
  .field span { font-size:12px; font-weight:600; letter-spacing:.09em; text-transform:uppercase; color:var(--olive); }
  .field input, .field select, .field textarea { font-size:15px; padding:12px 14px; border:1px solid rgba(0,0,0,.16); border-radius:8px; background:#fff; color:var(--ink); outline:none; }
  .field input:focus, .field select:focus, .field textarea:focus { border-color:var(--green-deep); }
  .field textarea { resize:vertical; line-height:1.6; }

  /* Reveal */
  [data-reveal] { opacity:0; transform:translateY(16px); transition:opacity 600ms var(--ease), transform 600ms var(--ease); }
  [data-reveal].is-visible { opacity:1; transform:none; }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity:1; transform:none; transition:none; }
  }

  /* Mobile nav */
  .nav-toggle { display:none; align-items:center; justify-content:center; width:42px; height:42px; background:none; border:1px solid rgba(0,0,0,.12); border-radius:10px; cursor:pointer; padding:0; }
  .nav-toggle:focus-visible { outline:2px solid var(--green-deep); outline-offset:2px; }
  .nav-toggle .bar { display:block; width:18px; height:2px; background:var(--green-deep); border-radius:2px; transition:transform 200ms var(--ease), opacity 200ms var(--ease); }
  .nav-toggle .bar + .bar { margin-top:4px; }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(1) { transform:translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(2) { opacity:0; }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(3) { transform:translateY(-6px) rotate(-45deg); }

  @media (max-width: 860px) {
    .wrap-nav { flex-wrap:nowrap; min-height:60px; }
    .brand span { font-size:15px; max-width:190px; }
    .nav-toggle { display:flex; flex-direction:column; }
    nav.site {
      position:absolute; top:100%; left:0; right:0;
      display:none; flex-direction:column; align-items:stretch; gap:0;
      background:#fff; border-bottom:1px solid var(--hair);
      box-shadow:0 12px 24px rgba(0,0,0,.08);
      padding:8px clamp(20px,4vw,56px) 20px;
    }
    header.site.is-open nav.site { display:flex; }
    nav.site .navlink {
      text-align:left; font-size:17px; padding:14px 0; min-height:48px;
      border-bottom:1px solid rgba(0,0,0,.06);
    }
    nav.site .navlink[aria-current="page"] { border-bottom-color:rgba(0,0,0,.06); color:var(--green-deep); font-weight:600; }
    nav.site .btn-nav { margin-top:16px; width:100%; padding:14px 20px; font-size:16px; }
  }

  @media (max-width: 600px) {
    h1.display { font-size:clamp(30px,8vw,40px); margin-top:20px; }
    h1.page { font-size:clamp(28px,7.5vw,36px); }
    h2.sect { font-size:clamp(24px,6.5vw,32px); }
    .lede, .body { font-size:16px; }
    .card, .card-lg { padding:22px; }
    .btn { width:100%; text-align:center; }
    .grid-team { grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:18px; }
    .frame { padding:8px; border-radius:16px; }
  }

  [hidden] { display:none !important; }
</style>
</head>
<body>

<header class="site" id="site-header" style="position:sticky">
  <div class="wrap-nav" style="position:relative">
    <button type="button" class="brand" data-nav="home">
      <img src="/assets/bayc-logo.png" alt="Bay Area Youth Conservation logo" />
      <span>Bay Area Youth Conservation</span>
    </button>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
    <nav class="site" id="site-nav">
      <button type="button" class="navlink" data-nav="home">Home</button>
      <button type="button" class="navlink" data-nav="work">What We Do</button>
      <button type="button" class="navlink" data-nav="team">Our Team</button>
      <button type="button" class="navlink" data-nav="involved">Get Involved</button>
      <button type="button" class="btn-nav" data-nav="contact">Contact</button>
    </nav>
  </div>
</header>

<!-- ============ HOME ============ -->
<main data-page="home">
  <section style="background:var(--lime-pale);border-bottom:1px solid rgba(0,0,0,.06);padding:clamp(56px,9vw,110px) clamp(20px,4vw,56px) clamp(52px,8vw,96px)">
    <div style="max-width:880px;margin:0 auto;text-align:center" data-reveal>
      <div class="eyebrow" style="display:inline-block;border:1px solid rgba(46,74,36,.22);background:#fff;padding:7px 15px;border-radius:9999px">Youth-led conservation in the Bay Area</div>
      <h1 class="display">Helping local students turn climate care into community action.</h1>
      <p class="lede" style="max-width:640px;margin:22px auto 0">Bay Area Youth Conservation brings young people together through climate education, hands-on volunteer opportunities, and community workshops in the San Leandro and San Lorenzo area.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:32px">
        <button type="button" class="btn btn-primary" data-nav="involved">Get involved</button>
        <button type="button" class="btn btn-ghost" data-nav="contact">Ask us a question</button>
      </div>
    </div>
  </section>

  <section class="band-green" style="padding:clamp(40px,5vw,60px) clamp(20px,4vw,56px)">
    <div style="max-width:1100px;margin:0 auto">
      <div style="text-align:center;font-family:var(--font-display);font-weight:600;font-size:clamp(20px,2vw,26px);color:#F2F5F0;letter-spacing:-.01em">Rooted in local youth action.</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:clamp(20px,3vw,36px);margin-top:32px" data-reveal>
        <div style="text-align:center;padding:0 12px">
          <div style="font-family:var(--font-display);font-weight:700;font-size:clamp(28px,3vw,38px);color:#fff;letter-spacing:-.02em">Youth-led</div>
          <div style="margin-top:8px;font-size:14.5px;line-height:1.55;color:rgba(255,255,255,.82)">Built by students for students, families, and local neighbors.</div>
        </div>
        <div style="text-align:center;padding:0 12px;border-left:1px solid rgba(101,224,221,.4)">
          <div style="font-family:var(--font-display);font-weight:700;font-size:clamp(28px,3vw,38px);color:#fff;letter-spacing:-.02em">2 months</div>
          <div style="margin-top:8px;font-size:14.5px;line-height:1.55;color:rgba(255,255,255,.82)">Workshop rhythm at San Leandro Library.</div>
        </div>
        <div style="text-align:center;padding:0 12px;border-left:1px solid rgba(101,224,221,.4)">
          <div style="font-family:var(--font-display);font-weight:700;font-size:clamp(28px,3vw,38px);color:#fff;letter-spacing:-.02em">East Bay</div>
          <div style="margin-top:8px;font-size:14.5px;line-height:1.55;color:rgba(255,255,255,.82)">Focused on San Leandro, San Lorenzo, and nearby communities.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div data-reveal>
        <div class="eyebrow">Who We Are</div>
        <h2 class="sect">A youth group making conservation approachable.</h2>
        <p class="body" style="margin:20px 0 0">Bay Area Youth Conservation is focused on making conservation approachable for students, families, and local neighbors. We share climate education, create space for youth involvement, and connect people with practical ways to care for the Bay Area environment, starting in San Leandro and San Lorenzo.</p>
        <button type="button" class="link-btn" style="margin-top:24px" data-nav="work">See what we do</button>
      </div>
      <div class="frame" data-reveal>
        <div class="photo-placeholder" style="height:clamp(280px,32vw,420px)">Replace with a workshop or volunteer-day photo</div>
      </div>
    </div>
  </section>

  <section class="sec band-pale">
    <div class="wrap">
      <div style="max-width:720px" data-reveal>
        <div class="eyebrow">What We Do</div>
        <h2 class="sect">Education, service, and local partnerships.</h2>
      </div>
      <div class="grid grid-4" style="margin-top:44px" data-reveal>
        <div class="card">
          <div class="kicker">Every 2 months</div>
          <h3 class="card-title">Workshops</h3>
          <p class="body-sm" style="margin:10px 0 0">We host community workshops every two months at San Leandro Library, with youth-friendly topics that make local environmental action easier to understand.</p>
        </div>
        <div class="card">
          <div class="kicker">Take action</div>
          <h3 class="card-title">Volunteer Opportunities</h3>
          <p class="body-sm" style="margin:10px 0 0">We connect students with conservation-minded service opportunities that support neighborhoods, outdoor spaces, and community awareness.</p>
        </div>
        <div class="card">
          <div class="kicker">Learn locally</div>
          <h3 class="card-title">Education Posts</h3>
          <p class="body-sm" style="margin:10px 0 0">Through short, accessible posts, we share climate facts, sustainability tips, and conservation ideas students can use in everyday life.</p>
        </div>
        <div class="card">
          <div class="kicker">Partner up</div>
          <h3 class="card-title">Collaborations</h3>
          <p class="body-sm" style="margin:10px 0 0">We work with schools, clubs, libraries, and local groups to bring youth conservation projects and education to more people.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div style="max-width:880px;margin:0 auto;text-align:center" data-reveal>
      <div class="eyebrow">Have a question</div>
      <h2 class="sect" style="font-size:clamp(26px,3.2vw,40px)">Not sure where you fit in? Just ask.</h2>
      <p class="body" style="margin:18px auto 0;max-width:600px">Whether you want to attend a workshop, volunteer, or bring BAYC to your school or community space, send us a note and we will get back to you.</p>
      <button type="button" class="btn btn-primary" style="margin-top:28px" data-nav="contact">Go to contact form</button>
    </div>
  </section>
</main>

<!-- ============ WHAT WE DO ============ -->
<main data-page="work" hidden>
  <section class="sec-sm" style="background:var(--lime-pale);border-bottom:1px solid rgba(0,0,0,.06)">
    <div style="max-width:820px;margin:0 auto;text-align:center">
      <div class="eyebrow">What We Do</div>
      <h1 class="page">Education, service, and local partnerships.</h1>
      <p class="body" style="max-width:620px;margin:20px auto 0">Four ways we work in San Leandro, San Lorenzo, and nearby communities.</p>
    </div>
  </section>

  <section class="sec-sm">
    <div style="max-width:1000px;margin:0 auto;display:flex;flex-direction:column;gap:20px">
      <div class="card-lg" data-reveal>
        <div class="kicker">Every 2 months</div>
        <h2 class="card-title" style="font-size:clamp(22px,2.4vw,28px);font-family:var(--font-display);font-weight:700;color:var(--green-deep);margin:12px 0 0;letter-spacing:-.015em">Workshops</h2>
        <p class="body" style="margin:12px 0 0;max-width:640px;font-size:16px;line-height:1.7">We host community workshops every two months at San Leandro Library, with youth-friendly topics that make local environmental action easier to understand.</p>
      </div>
      <div class="card-lg" data-reveal>
        <div class="kicker">Take action</div>
        <h2 class="card-title" style="font-size:clamp(22px,2.4vw,28px);font-family:var(--font-display);font-weight:700;color:var(--green-deep);margin:12px 0 0;letter-spacing:-.015em">Volunteer Opportunities</h2>
        <p class="body" style="margin:12px 0 0;max-width:640px;font-size:16px;line-height:1.7">We connect students with conservation-minded service opportunities that support neighborhoods, outdoor spaces, and community awareness.</p>
      </div>
      <div class="card-lg" data-reveal>
        <div class="kicker">Learn locally</div>
        <h2 class="card-title" style="font-size:clamp(22px,2.4vw,28px);font-family:var(--font-display);font-weight:700;color:var(--green-deep);margin:12px 0 0;letter-spacing:-.015em">Education Posts</h2>
        <p class="body" style="margin:12px 0 0;max-width:640px;font-size:16px;line-height:1.7">Through short, accessible posts, we share climate facts, sustainability tips, and conservation ideas students can use in everyday life.</p>
      </div>
      <div class="card-lg" data-reveal>
        <div class="kicker">Partner up</div>
        <h2 class="card-title" style="font-size:clamp(22px,2.4vw,28px);font-family:var(--font-display);font-weight:700;color:var(--green-deep);margin:12px 0 0;letter-spacing:-.015em">Collaborations</h2>
        <p class="body" style="margin:12px 0 0;max-width:640px;font-size:16px;line-height:1.7">We work with schools, clubs, libraries, and local groups to bring youth conservation projects and education to more people.</p>
      </div>
    </div>
  </section>

  <section class="sec-sm" style="background:var(--lime-pale);border-top:1px solid rgba(0,0,0,.06)">
    <div style="max-width:1000px;margin:0 auto">
      <div style="max-width:700px" data-reveal>
        <div class="eyebrow">Upcoming / Recent Activities</div>
        <h2 class="sect" style="font-size:clamp(24px,2.8vw,34px)">A community feed, built for real-world action.</h2>
        <p class="body" style="margin:16px 0 0;font-size:16px;line-height:1.7">BAYC shares workshop announcements, recaps, and simple conservation education through Instagram-style posts that are easy for students to follow and share.</p>
      </div>
      <div style="margin-top:32px;padding:14px;background:var(--lime-soft);border-radius:22px" data-reveal>
        <img src="/assets/bayc-social-reference.png" alt="Collage of Bay Area Youth Conservation Instagram posts" style="width:100%;display:block;border-radius:14px;object-fit:contain;background:#fff" />
      </div>
      <div style="margin-top:20px"><a href="https://www.instagram.com/youth_conservation/" style="font-size:15px;font-weight:600">Follow @youth_conservation</a></div>
    </div>
  </section>
</main>

<!-- ============ TEAM ============ -->
<main data-page="team" hidden>
  <section class="sec-sm" style="background:var(--lime-pale);border-bottom:1px solid rgba(0,0,0,.06)">
    <div style="max-width:820px;margin:0 auto;text-align:center">
      <div class="eyebrow">Our Team</div>
      <h1 class="page">The students behind BAYC.</h1>
      <p class="body" style="max-width:600px;margin:20px auto 0">BAYC is run by local students who plan the workshops, write the education posts, and coordinate with libraries, schools, and community groups.</p>
    </div>
  </section>

  <section class="sec-sm">
    <div class="wrap grid grid-team" data-reveal>
      <div style="text-align:center">
        <div class="photo-placeholder" style="height:260px">Photo</div>
        <div class="kicker" style="margin-top:16px">Role</div>
        <div style="margin-top:6px;font-family:var(--font-display);font-weight:700;font-size:20px;color:var(--green-deep);letter-spacing:-.01em">Name</div>
      </div>
      <div style="text-align:center">
        <div class="photo-placeholder" style="height:260px">Photo</div>
        <div class="kicker" style="margin-top:16px">Role</div>
        <div style="margin-top:6px;font-family:var(--font-display);font-weight:700;font-size:20px;color:var(--green-deep);letter-spacing:-.01em">Name</div>
      </div>
      <div style="text-align:center">
        <div class="photo-placeholder" style="height:260px">Photo</div>
        <div class="kicker" style="margin-top:16px">Role</div>
        <div style="margin-top:6px;font-family:var(--font-display);font-weight:700;font-size:20px;color:var(--green-deep);letter-spacing:-.01em">Name</div>
      </div>
      <div style="text-align:center">
