---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homePage, toPublicPath } from "../lib/content";
---

<BaseLayout title={homePage.title} description={homePage.description} currentPath="/">
  <main>
    <section class="hero">
      <img
        class="hero-img"
        src="/assets/lake-chabot.webp"
        alt="Lake Chabot in San Leandro, California"
      />
      <div class="hero-scrim"></div>
      <div class="hero-inner" data-reveal>
        <div class="hero-eyebrow">{homePage.hero.eyebrow}</div>
        <h1 class="display hero-h1">{homePage.hero.heading}</h1>
        <p class="lede hero-lede">{homePage.hero.body}</p>
        <div class="hero-cta">
          <a class="btn btn-on-green" href={homePage.hero.primaryCta.href}>
            {homePage.hero.primaryCta.label}
          </a>
          <a class="btn btn-on-photo" href={homePage.hero.secondaryCta.href}>
            {homePage.hero.secondaryCta.label}
          </a>
        </div>
      </div>
      <div class="hero-caption">Lake Chabot · San Leandro</div>
    </section>

    <section class="band-green highlight-band">
      <div class="wrap">
        <h2>{homePage.highlights.heading}</h2>
        <div class="highlight-grid" data-reveal>
          {
            homePage.highlights.items.map((item) => (
              <article>
                <strong>{item.value}</strong>
                <p>{item.label}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap split">
        <div data-reveal>
          <div class="eyebrow">{homePage.whoWeAre.eyebrow}</div>
          <h2 class="sect">{homePage.whoWeAre.heading}</h2>
          <p class="body">{homePage.whoWeAre.body}</p>
          <div class="placeholder-note mission-goal">
            <div class="kicker">Our goal</div>
            <p class="body">
              Our ultimate goal is to show the youth that change is possible. We encourage and support any kinds of interest in environmental justice. Through small actions and steps, we can have a cleaner neighborhood and a more sustainable and ecologically educated community.
            </p>
          </div>
          <a class="link-btn" href={homePage.whoWeAre.linkHref}>{homePage.whoWeAre.linkLabel}</a>
        </div>
        <div class="frame" data-reveal>
          {
            homePage.whoWeAre.photo ? (
              <img
                class="photo about-photo"
                src={toPublicPath(homePage.whoWeAre.photo)}
                alt={homePage.whoWeAre.photoAlt}
                loading="lazy"
              />
            ) : (
              <div class="photo-placeholder about-photo">{homePage.whoWeAre.photoPlaceholder}</div>
            )
          }
        </div>
      </div>
    </section>

    <section class="sec band-pale">
      <div class="wrap">
        <div class="section-intro" data-reveal>
          <div class="eyebrow">{homePage.workSummary.eyebrow}</div>
          <h2 class="sect">{homePage.workSummary.heading}</h2>
        </div>
        <div class="grid grid-4 card-stack" data-reveal>
          {
            homePage.workSummary.cards.map((card) => (
              <article class="card">
                <div class="kicker">{card.kicker}</div>
                <h3 class="card-heading">{card.heading}</h3>
                <p class="body-sm">{card.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec ask-band">
      <div data-reveal>
        <div class="eyebrow">{homePage.ask.eyebrow}</div>
        <h2 class="sect">{homePage.ask.heading}</h2>
        <p class="body">{homePage.ask.body}</p>
        <a class="btn btn-primary" href={homePage.ask.cta.href}>{homePage.ask.cta.label}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(480px, 72vh, 660px);
    padding: clamp(48px, 7vw, 88px) clamp(20px, 4vw, 56px) clamp(40px, 5vw, 64px);
    overflow: hidden;
    background: #2A3A2A;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(16, 28, 14, 0.92) 0%,
      rgba(16, 28, 14, 0.74) 38%,
      rgba(16, 28, 14, 0.34) 72%,
      rgba(16, 28, 14, 0.18) 100%
    );
  }

  .hero-inner {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 7px 15px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    backdrop-filter: blur(4px);
  }

  h1.hero-h1 {
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .hero-lede {
    max-width: 640px;
    margin: 22px auto 0;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn-on-photo {
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    backdrop-filter: blur(4px);
  }

  .btn-on-photo:hover {
    border-color: #fff;
    background: #fff;
    color: var(--green-deep);
  }

  .hero-caption {
    position: absolute;
    right: clamp(20px, 4vw, 56px);
    bottom: 16px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .mission-goal {
    margin-top: 26px;
  }

  .mission-goal .body {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .hero {
      min-height: clamp(420px, 78vh, 540px);
      padding-bottom: 52px;
    }

    .hero-lede { margin-top: 16px; }
    .hero-cta { margin-top: 26px; }
    .hero-caption {
      right: auto;
      bottom: 14px;
      left: clamp(20px, 4vw, 56px);
      font-size: 10.5px;
    }
  }
</style>
