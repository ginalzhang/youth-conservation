  </section>

  <section class="sec-sm">
    <div class="wrap grid grid-3" style="gap:22px" data-reveal>
      <div class="card" style="padding:28px">
        <div class="kicker">San Leandro Library</div>
        <h2 class="card-title" style="font-family:var(--font-display);font-weight:700;font-size:21px;color:var(--green-deep);margin:12px 0 0;letter-spacing:-.01em">Attend a workshop</h2>
        <p class="body-sm" style="margin:10px 0 0;line-height:1.7">Join the every-two-month workshop series at San Leandro Library for climate learning, hands-on projects, and conversation.</p>
      </div>
      <div class="card" style="padding:28px">
        <div class="kicker">Youth service</div>
        <h2 class="card-title" style="font-family:var(--font-display);font-weight:700;font-size:21px;color:var(--green-deep);margin:12px 0 0;letter-spacing:-.01em">Volunteer with us</h2>
        <p class="body-sm" style="margin:10px 0 0;line-height:1.7">Take part in local opportunities that help students contribute time, energy, and care to the places around them.</p>
      </div>
      <div class="card" style="padding:28px">
        <div class="kicker">Schools, clubs, libraries</div>
        <h2 class="card-title" style="font-family:var(--font-display);font-weight:700;font-size:21px;color:var(--green-deep);margin:12px 0 0;letter-spacing:-.01em">Collaborate</h2>
        <p class="body-sm" style="margin:10px 0 0;line-height:1.7">We work with schools, clubs, libraries, and local groups to bring youth conservation projects and education to more people.</p>
      </div>
    </div>
  </section>

  <section class="band-green" style="padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px)">
    <div style="max-width:820px;margin:0 auto;text-align:center" data-reveal>
      <div style="font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.7)">Collaborate With Us</div>
      <h2 style="font-family:var(--font-display);font-weight:700;font-size:clamp(26px,3.4vw,42px);line-height:1.14;letter-spacing:-.02em;color:#fff;margin:14px 0 0">Bring youth conservation education to your community space.</h2>
      <p style="margin:20px auto 0;max-width:620px;font-size:16.5px;line-height:1.7;color:rgba(255,255,255,.82)">Bay Area Youth Conservation is open to local collaborations, workshop ideas, volunteer projects, and education partnerships across the San Leandro and San Lorenzo area.</p>
      <button type="button" class="btn btn-onGreen" style="margin-top:30px" data-nav="contact">Start a collaboration</button>
    </div>
  </section>
</main>

