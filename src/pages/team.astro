---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisibleTeamMembers, teamPage, toPublicPath } from "../lib/content";

const members = getVisibleTeamMembers();
---

<BaseLayout title={teamPage.title} description={teamPage.description} currentPath="/team/">
  <main>
    <section class="sec-sm page-header">
      <div class="page-header-inner">
        <div class="eyebrow">{teamPage.header.eyebrow}</div>
        <h1 class="page">{teamPage.header.heading}</h1>
        <p class="body">{teamPage.header.body}</p>
      </div>
    </section>

    <section class="sec-sm">
      <div class="wrap grid grid-team" data-reveal>
        {
          members.length > 0
            ? members.map((member) => (
                <article class="team-card">
                  {member.photo ? (
                    <img
                      class="photo team-photo"
                      src={toPublicPath(member.photo)}
                      alt={member.photoAlt || member.name}
                      loading="lazy"
                    />
                  ) : (
                    <div class="photo-placeholder">Photo</div>
                  )}
                  <div class="kicker">{member.role}</div>
                  <h2>{member.name}</h2>
                  {member.bio ? <p class="body-sm">{member.bio}</p> : null}
                </article>
              ))
            : null
        }
      </div>
      {members.length === 0 ? <div class="wrap placeholder-note">Add team members in TinaCMS to show them here.</div> : null}
    </section>
  </main>
</BaseLayout>
