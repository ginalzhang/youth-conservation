---
import BaseLayout from "../layouts/BaseLayout.astro";
import { problemPage } from "../lib/content";

const findings = problemPage.blockTwo.findings as string[];
const learnMoreLinks = problemPage.learnMore.links as Array<{ label: string; href: string }>;
---

<BaseLayout
  title={problemPage.title}
  description={problemPage.description}
  currentPath="/the-problem/"
>
  <main>
    <!-- PAGE HEADER -->
    <section class="sec-sm problem-header">
      <div class="problem-header-inner">
        <div class="eyebrow">{problemPage.header.eyebrow}</div>
        <h1 class="page">{problemPage.header.heading}</h1>
      </div>
    </section>

    <!-- THESIS: one statement, one lede, one body paragraph -->
    <section class="sec-sm">
      <div class="wrap problem-thesis">
        <div data-reveal>
          <h2 class="sect problem-thesis-heading">{problemPage.thesis.heading}</h2>
          <div class="text-slot problem-lede-slot">
            <p>{problemPage.thesis.lede}</p>
          </div>
          <div class="text-slot problem-body-slot">
            <p>{problemPage.thesis.body}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 1 — text left, chart right -->
    <section class="sec-sm band-pale">
      <div class="wrap split">
        <div data-reveal>
          <div class="eyebrow">{problemPage.blockOne.eyebrow}</div>
          <h3 class="sect problem-block-heading">{problemPage.blockOne.heading}</h3>
          <div class="text-slot problem-text-slot">
            <p>{problemPage.blockOne.body}</p>
          </div>
          <p class="src-slot">
            Source: <a href={problemPage.blockOne.sourceHref}>{problemPage.blockOne.sourceLabel}</a>
          </p>
        </div>
        <div class="frame" data-reveal>
          <div class="photo-placeholder problem-visual-slot">{problemPage.blockOne.imagePlaceholder}</div>
        </div>
      </div>
    </section>

    <!-- BLOCK 2 — bulleted findings left, map right -->
    <section class="sec-sm">
      <div class="wrap split">
        <div data-reveal>
          <div class="eyebrow">{problemPage.blockTwo.eyebrow}</div>
          <h3 class="sect problem-block-heading">{problemPage.blockTwo.heading}</h3>
          <div class="text-slot problem-text-slot">
            <p>{problemPage.blockTwo.body}</p>
          </div>
          <ul class="text-slot problem-finding-list">
            {findings.map((finding) => <li>{finding}</li>)}
          </ul>
          <p class="src-slot">
            Source: <a href={problemPage.blockTwo.sourceHref}>{problemPage.blockTwo.sourceLabel}</a>
          </p>
        </div>
        <div class="frame" data-reveal>
          <div class="photo-placeholder problem-visual-slot">{problemPage.blockTwo.imagePlaceholder}</div>
        </div>
      </div>
    </section>

    <!-- BLOCK 3 — image left, text right -->
    <section class="sec-sm band-pale">
      <div class="wrap split">
        <div class="frame" data-reveal>
          <div class="photo-placeholder problem-visual-slot">{problemPage.blockThree.imagePlaceholder}</div>
        </div>
        <div data-reveal>
          <div class="eyebrow">{problemPage.blockThree.eyebrow}</div>
          <h3 class="sect problem-block-heading">{problemPage.blockThree.heading}</h3>
          <div class="text-slot problem-text-slot">
            <p>{problemPage.blockThree.body}</p>
          </div>
          <p class="src-slot">
            Source: <a href={problemPage.blockThree.sourceHref}>{problemPage.blockThree.sourceLabel}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- BLOCK 4 — full width, no image -->
    <section class="sec-sm">
      <div class="wrap problem-thesis">
        <div data-reveal>
          <div class="eyebrow">{problemPage.blockFour.eyebrow}</div>
          <h3 class="sect problem-block-heading">{problemPage.blockFour.heading}</h3>
          <div class="text-slot problem-text-slot">
            {problemPage.blockFour.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>

    <!-- LEARN MORE -->
    <section class="sec-sm band-pale">
      <div class="wrap problem-learn-more">
        <div data-reveal>
          <h2 class="sect problem-learn-heading">{problemPage.learnMore.heading}</h2>
          <div class="problem-resource-list">
            {learnMoreLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="band-green problem-cta">
      <div class="problem-cta-inner" data-reveal>
        <h2>{problemPage.cta.heading}</h2>
        <a class="btn btn-on-green" href={problemPage.cta.href}>{problemPage.cta.label}</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .problem-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: var(--lime-pale);
  }

  .problem-header-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .problem-thesis {
    max-width: 820px;
  }

  .problem-thesis-heading {
    font-size: clamp(24px, 3vw, 36px);
    text-transform: uppercase;
  }

  .problem-lede-slot {
    margin-top: 22px;
    font-size: 16.5px;
  }

  .problem-body-slot,
  .problem-text-slot {
    margin-top: 16px;
  }

  .problem-block-heading {
    font-size: clamp(21px, 2.4vw, 27px);
  }

  .problem-text-slot {
    margin-top: 18px;
  }

  .problem-finding-list {
    margin-top: 14px;
    padding-left: 34px;
    list-style: disc;
  }

  .problem-visual-slot {
    height: clamp(260px, 30vw, 380px);
  }

  .problem-learn-more {
    max-width: 780px;
  }

  .problem-learn-heading {
    font-size: clamp(22px, 2.6vw, 30px);
  }

  .problem-resource-list {
    display: flex;
    flex-direction: column;
    margin-top: 22px;
  }

  .problem-resource-list a {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.09);
    font-size: 16px;
    font-weight: 600;
  }

  .problem-cta {
    padding: clamp(56px, 7vw, 96px) clamp(20px, 4vw, 56px);
  }

  .problem-cta-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .problem-cta h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.14;
  }

  .problem-cta .btn {
    margin-top: 26px;
  }
</style>
