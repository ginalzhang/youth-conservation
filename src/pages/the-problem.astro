---
import BaseLayout from "../layouts/BaseLayout.astro";
import { problemPage, toPublicPath } from "../lib/content";

const problemSections = problemPage.sections as Array<{
  eyebrow: string;
  heading: string;
  body: string;
  image?: string;
  imageAlt?: string;
  imagePlaceholder: string;
  sourceLabel?: string;
  sourceHref?: string;
}>;
const learnLinks = problemPage.learnMore.links as Array<{ label: string; href: string }>;
---

<BaseLayout
  title={problemPage.title}
  description={problemPage.description}
  currentPath="/the-problem/"
>
  <main>
    <section class="sec-sm page-header problem-header">
      <div class="page-header-inner">
        <div class="eyebrow">{problemPage.header.eyebrow}</div>
        <h1 class="page">{problemPage.header.heading}</h1>
        <p class="body">{problemPage.header.body}</p>
      </div>
    </section>

    <section class="sec-sm problem-section">
      <div class="wrap problem-stack">
        {
          problemSections.map((section, index) => (
            <article class={`problem-block ${index % 2 === 1 ? "is-flipped" : ""}`} data-reveal>
              <div class="problem-copy">
                <div class="kicker">{section.eyebrow}</div>
                <h2>{section.heading}</h2>
                {section.body
                  .split("\n")
                  .filter(Boolean)
                  .map((paragraph) => (
                    <p class="body">{paragraph}</p>
                  ))}
                {section.sourceLabel ? (
                  <p class="body-sm problem-source">
                    Source:{" "}
                    {section.sourceHref ? (
                      <a href={section.sourceHref} target="_blank" rel="noopener noreferrer">
                        {section.sourceLabel}
                      </a>
                    ) : (
                      section.sourceLabel
                    )}
                  </p>
                ) : null}
              </div>
              <div class="problem-media">
                {section.image ? (
                  <img
                    src={toPublicPath(section.image)}
                    alt={section.imageAlt || ""}
                    loading="lazy"
                  />
                ) : (
                  <div class="photo-placeholder problem-placeholder">{section.imagePlaceholder}</div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      learnLinks.length > 0 ? (
        <section class="sec-sm band-pale">
          <div class="wrap learn-more" data-reveal>
            <h2 class="sect">{problemPage.learnMore.heading}</h2>
            <div class="learn-links">
              {learnLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null
    }
  </main>
</BaseLayout>

<style>
  .problem-header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: var(--lime-pale);
  }

  .problem-section {
    padding-top: 0;
  }

  .problem-stack {
    max-width: 1060px;
  }

  .problem-block {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding: clamp(48px, 7vw, 88px) 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }

  .problem-block:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.07);
  }

  .problem-block.is-flipped .problem-copy {
    order: 2;
  }

  .problem-copy h2 {
    max-width: 720px;
    margin: 14px 0 0;
    color: var(--green-deep);
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
    text-transform: uppercase;
  }

  .problem-copy .body {
    max-width: 680px;
    margin-top: 20px;
  }

  .problem-source {
    margin-top: 18px;
  }

  .problem-source a,
  .learn-links a {
    font-weight: 600;
  }

  .problem-media {
    padding: 10px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .problem-media img,
  .problem-placeholder {
    width: 100%;
    min-height: clamp(260px, 32vw, 420px);
    border-radius: 12px;
  }

  .problem-media img {
    height: auto;
    object-fit: contain;
  }

  .learn-more {
    max-width: 880px;
  }

  .learn-links {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
  }

  @media (max-width: 760px) {
    .problem-block {
      grid-template-columns: 1fr;
    }

    .problem-block.is-flipped .problem-copy {
      order: initial;
    }
  }
</style>
